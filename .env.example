# Copy to `.env` and fill in your Supabase credentials.
# Get values from: Supabase Dashboard -> Project Settings -> API
#
# Development: place `.env` in the project root (same folder as pubspec.yaml).
#
# Installed / copied build on another PC:
#   Copy this file as `.env` into the SAME folder as restaurix.exe
#   Example: build\windows\x64\runner\Release\.env
#
# Optional: `%APPDATA%\com.example\restaurix\.env` (per-user override)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
